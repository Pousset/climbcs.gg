# Copy to .env and adjust. Every variable is validated at startup (see src/config/env.ts).
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database: sqlite (local, default) or postgres
DB_TYPE=sqlite
SQLITE_PATH=./storage/dev.sqlite
# DATABASE_URL=postgres://cs2:cs2@localhost:5432/cs2

# Authentication (JWT_SECRET is mandatory in production, 16+ characters)
# JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Uploads and parsed replays
STORAGE_DIR=./storage
MAX_DEMO_SIZE_MB=512

# V1 product demo: lets an account switch between free and premium (404 when false)
ENABLE_DEV_PLAN_SWITCH=true
