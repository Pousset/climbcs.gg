    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15"
  },
  "dependencies": {
    "@laihoe/demoparser2": "^0.42.0",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/typeorm": "^11.0.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
