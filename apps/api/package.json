{
  "name": "@cs2/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS REST API: authentication, quota, demo upload and parsing.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json --watch",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start:env": "node --env-file=.env dist/main.js"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
